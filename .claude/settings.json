{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/lang-rule.sh" },
          { "type": "command", "command": "cat .claude/skills/work-style/SKILL.md 2>/dev/null || true" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/lang-rule.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/lang-check.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
